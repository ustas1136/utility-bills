# UID/GID пользователя WSL — определяют владельца файлов, создаваемых в контейнерах.
# Узнать свои: id -u && id -g
UID=1000
GID=1000

# Scheduler
SCHEDULER_ENABLED=true
SCHEDULER_INTERVAL_MINUTES=60

# SMTP (dev: оставьте пустыми — письма пишутся в лог)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@utility-bills.local
SMTP_USE_TLS=true