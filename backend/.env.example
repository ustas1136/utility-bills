# App
ENVIRONMENT=development
DEBUG=true
APP_NAME=utility-bills

# Database
DATABASE_URL=postgresql+psycopg://user:password@db:5432/utility_bills

# JWT (понадобится на этапе 2, но закладываем сразу)
JWT_SECRET=change-me-in-production-please-use-openssl-rand-hex-32
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30

# CORS
CORS_ORIGINS=["http://localhost:3000","http://localhost:8000"]